# Copy these settings into Render's Environment page or use render.yaml.
# This file is documentation only; do not copy it over .env or leave the secret values blank in Render.
# Supabase credentials must be from Project Settings > Database (not the anon key, service-role key, or PAT).

NODE_ENV=production
DATABASE_TYPE=postgres
DATABASE_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres.mpzrctaafcltfrpdzgqn
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SYNCHRONIZE=false
DATABASE_POOL_SIZE=5
POSTGRES_BUILTIN=false
AUTO_START_SESSIONS=true
WWEBJS_WEB_VERSION=off

# Set both as secrets in Render. Generate API_MASTER_KEY with: openssl rand -hex 32
API_MASTER_KEY=

# Render supplies PORT automatically; do not set it here.
